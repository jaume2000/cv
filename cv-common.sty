% Shared layout, fonts and macros for resume.tex and resume_software.tex.
% Loaded after \documentclass{awesome-cv}.
\ProvidesPackage{cv-common}

% Tuned for a single dense ATS-friendly page: smaller header/photo, tight section skips.
\geometry{left=1.2cm, top=.4cm, right=1.2cm, bottom=0.7cm, footskip=.5cm}

\renewcommand{\acvSectionTopSkip}{0.7mm}
\renewcommand{\acvSectionContentTopSkip}{1.0mm}

\makeatletter
\renewcommand*{\sectionstyle}[1]{{\fontsize{12.5pt}{1em}\bodyfont\bfseries\color{text}\@sectioncolor #1}}
\renewcommand*{\paragraphstyle}{\fontsize{8pt}{1em}\bodyfontlight\upshape\color{text}}
\renewcommand*{\descriptionstyle}[1]{{\fontsize{8pt}{1em}\bodyfontlight\upshape\color{text} #1}}
\renewcommand*{\entrytitlestyle}[1]{{\fontsize{9pt}{1em}\bodyfont\bfseries\color{darktext} #1}}
\renewcommand*{\entrylocationstyle}[1]{{\fontsize{8pt}{1em}\bodyfontlight\slshape\color{awesome} #1}}
\renewcommand*{\entrydatestyle}[1]{{\fontsize{8pt}{1em}\bodyfontlight\slshape\color{graytext} #1}}
\renewcommand*{\skilltypestyle}[1]{{\fontsize{8.5pt}{1em}\bodyfont\bfseries\color{darktext} #1}}
\renewcommand*{\skillsetstyle}[1]{{\fontsize{8pt}{1em}\bodyfontlight\color{text} #1}}
\renewcommand*{\honortitlestyle}[1]{{\fontsize{8pt}{1em}\bodyfont\color{graytext} #1}}
\renewcommand*{\honorpositionstyle}[1]{{\fontsize{8pt}{1em}\bodyfont\bfseries\color{darktext} #1}}
\renewcommand*{\honordatestyle}[1]{{\fontsize{8pt}{1em}\bodyfont\color{graytext} #1}}
\renewcommand*{\honorlocationstyle}[1]{{\fontsize{8pt}{1em}\bodyfontlight\slshape\color{awesome} #1}}

\renewcommand*{\headerfirstnamestyle}[1]{{\fontsize{20pt}{1em}\headerfontlight\color{graytext} #1}}
\renewcommand*{\headerlastnamestyle}[1]{{\fontsize{20pt}{1em}\headerfont\bfseries\color{text} #1}}
\renewcommand*{\headeraddressstyle}[1]{{\fontsize{7.2pt}{1em}\headerfont\itshape\color{lighttext} #1}}
\renewcommand*{\headersocialstyle}[1]{{\fontsize{6.4pt}{1em}\headerfont\color{text} #1}}
\makeatother

% Specify the location of the included fonts
\IfFileExists{fonts/Roboto-Regular.ttf}{\fontdir[fonts/]}{\fontdir[../fonts/]}

% Body text on Roboto (local), not Source Sans Pro: SSP maps U+002D/U+2011 to the same
% glyph, so PDF text extraction turns every ASCII hyphen into U+2011 (ATS-breaking).
\renewcommand*{\bodyfont}{\headerfont}
\renewcommand*{\bodyfontlight}{\headerfontlight}
\renewcommand*{\footerfont}{\headerfont}

% Color for highlights
\definecolor{awesome}{HTML}{2B547E}

% Set false if you don't want to highlight section with awesome color
\setbool{acvSectionColorHighlight}{true}

% If you would like to change the social information separator from a pipe (|) to something else
\renewcommand{\acvHeaderSocialSep}{\hspace{0.4em}\textbar\hspace{0.4em}}
\renewcommand{\acvHeaderAfterNameSkip}{0.2mm}
\renewcommand{\acvHeaderAfterPositionSkip}{0.2mm}
\renewcommand{\acvHeaderAfterAddressSkip}{-0.6mm}
\renewcommand{\acvHeaderAfterSocialSkip}{0.6mm}

% Missing facts are marked as "% TODO:" comments in the source. This red marker is used only in
% the one spot where an omission would silently render as a broken date range.
\newcommand{\todo}[1]{\textnormal{\textcolor{red}{[TODO: #1]}}}

% No automatic hyphenation (avoids microbiol- / ogists style breaks). Stretch instead.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\pretolerance=10000
\tolerance=3000
\emergencystretch=2.5em

% Discourage orphan section heads and widow lines
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000

% Keep entries from splitting across pages (tabular* is a box; this stops a break before it).
% The negative skip also pulls consecutive entries closer; the class leaves them fairly loose.
\newcommand{\cvkeep}{\par\nopagebreak\vspace{-1.9mm}}

% Header: small photo left; name/contact centered. One plain-text contact row for ATS.
\makeatletter
\renewcommand*{\makecvheader}[1][C]{%
  \newcommand*{\drawphoto}{%
    \ifthenelse{\isundefined{\@photo}}{}{%
      \newlength{\photodim}%
      \ifthenelse{\equal{\@photoshape}{circle}}%
        {\setlength{\photodim}{0.72cm}}%
        {\setlength{\photodim}{1.0cm}}%
      \ifthenelse{\equal{\@photoedge}{edge}}%
        {\def\@photoborder{darkgray}}%
        {\def\@photoborder{none}}%
      \begin{tikzpicture}%
        \node[\@photoshape, draw=\@photoborder, line width=0.25mm,
          inner sep=\photodim, fill overzoom image=\@photo] () {};
      \end{tikzpicture}%
    }%
  }%
  \newlength{\headerphotowidth}%
  \newlength{\headertextwidth}%
  \ifthenelse{\isundefined{\@photo}}{%
    \setlength{\headerphotowidth}{0cm}%
    \setlength{\headertextwidth}{\textwidth}%
  }{%
    \setlength{\headerphotowidth}{1.55cm}%
    \setlength{\headertextwidth}{\dimexpr\textwidth-2\headerphotowidth\relax}%
  }%
  \noindent
  \begin{minipage}[t]{\headerphotowidth}%
    \vspace{0pt}%
    \raggedright\drawphoto
  \end{minipage}%
  \begin{minipage}[t]{\headertextwidth}%
    \vspace{0pt}%
    \centering
    \headerfirstnamestyle{\@firstname}\headerlastnamestyle{{}\acvHeaderNameDelim\@lastname}%
    \\[\acvHeaderAfterNameSkip]%
    \ifthenelse{\isundefined{\@position}}{}{\headerpositionstyle{\@position\\[\acvHeaderAfterPositionSkip]}}%
    \ifthenelse{\isundefined{\@address}}{}{\headeraddressstyle{\@address\\[\acvHeaderAfterAddressSkip]}}%
    \headersocialstyle{%
      \newbool{isstart}%
      \setbool{isstart}{true}%
      \ifthenelse{\isundefined{\@mobile}}{}{%
        \@mobile%
        \setbool{isstart}{false}%
      }%
      \ifthenelse{\isundefined{\@email}}{}{%
        \ifbool{isstart}{\setbool{isstart}{false}}{\acvHeaderSocialSep}%
        \href{mailto:\@email}{\@email}%
      }%
      \ifthenelse{\isundefined{\@homepage}}{}{%
        \ifbool{isstart}{\setbool{isstart}{false}}{\acvHeaderSocialSep}%
        \href{https://\@homepage}{\@homepage}%
      }%
      \ifthenelse{\isundefined{\@github}}{}{%
        \ifbool{isstart}{\setbool{isstart}{false}}{\acvHeaderSocialSep}%
        \href{https://github.com/\@github}{github.com/\@github}%
      }%
      \ifthenelse{\isundefined{\@linkedin}}{}{%
        \ifbool{isstart}{\setbool{isstart}{false}}{\acvHeaderSocialSep}%
        \href{https://www.linkedin.com/in/\@linkedin}{linkedin.com/in/\@linkedin}%
      }%
      \ifthenelse{\isundefined{\@googlescholarid}}{}{%
        \ifbool{isstart}{\setbool{isstart}{false}}{\acvHeaderSocialSep}%
        \href{https://scholar.google.com/citations?user=\@googlescholarid}{\@googlescholarname}%
      }%
    }\\[\acvHeaderAfterSocialSkip]%
  \end{minipage}%
  \begin{minipage}[t]{\headerphotowidth}%
    \vspace{0pt}%
    \hfill
  \end{minipage}%
  \par
}

% ATS: never use \scshape or \MakeUppercase on fancy fonts.
\renewcommand*{\headerpositionstyle}[1]{{\fontsize{7pt}{1em}\bodyfont\bfseries\color{awesome}#1}}
\renewcommand*{\entrypositionstyle}[1]{{\fontsize{7.5pt}{1em}\bodyfont\color{graytext}#1}}
\renewcommand*{\footerstyle}[1]{{\fontsize{7pt}{1em}\footerfont\color{lighttext}#1}}
\renewcommand*{\subsectionstyle}[1]{{\fontsize{10pt}{1em}\bodyfont\color{text}#1}}

\newcommand*{\cvdegree}[4]{%
  \vspace{-2.2mm}%
  \setlength\tabcolsep{0pt}%
  \setlength{\extrarowheight}{0pt}%
  \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} L{\textwidth - 4.5cm} R{4.5cm}}
    \entrytitlestyle{#2} & \entrylocationstyle{#3} \\
    \entrypositionstyle{#1} & \entrydatestyle{#4}
  \end{tabular*}%
}
\makeatother

\renewenvironment{cvskills}{%
  \vspace{\acvSectionContentTopSkip}
  \vspace{-2.2mm}
  \begin{center}
    \setlength\tabcolsep{0.8ex}
    \setlength{\extrarowheight}{0pt}
    \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} r L{\textwidth * \real{0.82}}}
}{%
    \end{tabular*}
  \end{center}
}

% Tighter profile paragraph (class default adds 2mm after).
\renewenvironment{cvparagraph}{%
  \vspace{\acvSectionContentTopSkip}%
  \vspace{-3.5mm}%
  \paragraphstyle
}{%
  \par\vspace{0.4mm}%
}
